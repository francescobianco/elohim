# Un file <nome>.env per ogni hosting. Il contenuto di hosts/ è ignorato da git.
FTP_HOST=ftp://ftp.example.com
FTP_USER=utente
FTP_PASS='password'
FTP_DIR=/htdocs/elohim          # cartella remota dove finiscono elohim.php ed elohim.txt
URL=https://www.example.com/elohim/elohim.php   # URL pubblico di FTP_DIR/elohim.php
# FTP_SSL_VERIFY=false          # opzionale (default false, come in hookpool)
